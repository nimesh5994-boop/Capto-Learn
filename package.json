    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "marked": "^16.4.2",
    "next": "^16.2.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^4.8.0",
    "server-only": "^0.0.1",
